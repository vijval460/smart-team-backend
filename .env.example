# Teamforge Backend Environment Configuration Example
# Server Port (auto-assigned on platforms like Render/Railway)
PORT=8081

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://<DATABASE_HOST>:<DATABASE_PORT>/<DATABASE_NAME>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<DATABASE_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DATABASE_PASSWORD>

# CORS: Comma-separated list of allowed frontend origins
TEAMFORGE_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<YOUR_DEPLOYED_FRONTEND_DOMAIN>

# Demo Account Credentials (Optional)
TEAMFORGE_DEMO_EMAIL=demo@teamforge.dev
TEAMFORGE_DEMO_PASSWORD=teamforge123

# Session Cookie Configuration (Use 'none' and 'true' for cross-site HTTPS deployment)
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
